---
// FilterBar.astro - Barra de Busca e Filtros Avançados
---

<div class="controls-card">
  <div class="controls-row-top">
    <!-- Live Search -->
    <div class="search-input-wrapper">
      <svg class="search-icon" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="search-riv-input"
        class="search-input"
        placeholder="Buscar por RIV, Fornecedor, CNPJ, Responsável ou Categoria..."
        autocomplete="off"
      />
    </div>

    <!-- Dropdown Filters -->
    <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;">
      <select id="filter-select-status" class="filter-select" aria-label="Filtrar por Etapa">
        <option value="ALL">Todas as Etapas</option>
        <option value="Cadastro iniciado">Cadastro iniciado</option>
        <option value="Validação documental">Validação documental</option>
        <option value="Aprovação Compras">Aprovação Compras</option>
        <option value="Aprovação Financeira">Aprovação Financeira</option>
        <option value="Aprovação Global">Aprovação Global</option>
        <option value="Concluído">Concluído</option>
      </select>

      <select id="filter-select-sla" class="filter-select" aria-label="Filtrar por SLA">
        <option value="ALL">Todos os SLAs</option>
        <option value="No prazo">🟢 No prazo</option>
        <option value="Em risco">🟡 Em risco</option>
        <option value="Atrasado">🔴 Atrasado (Vencido)</option>
        <option value="Concluído">✅ Concluído</option>
      </select>
    </div>
  </div>

  <!-- Quick Filter Badges / Chips -->
  <div class="quick-filter-badges" id="filter-chips">
    <!-- Rendered dynamically by app.js -->
  </div>
</div>

---
// Header.astro - Barra de Navegação Corporativa Executiva
---

<header class="top-navbar">
  <div class="top-navbar-inner">
    <!-- Brand -->
    <div class="brand-section">
      <div class="brand-icon-wrapper">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
      </div>
      <div>
        <div class="brand-title">SupplierFlow <span style="font-weight: 400; color: #93c5fd; font-size: 0.95rem;">| Gestão RIV</span></div>
        <div class="brand-subtitle">Plataforma Executiva de Homologação e Cadastro de Fornecedores</div>
      </div>
    </div>

    <!-- View Switcher -->
    <nav class="view-tabs" aria-label="Navegação de Visualizações">
      <button class="tab-btn active" data-view="table" id="tab-table">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
        <span>Consulta de RIVs</span>
      </button>

      <button class="tab-btn" data-view="kanban" id="tab-kanban">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
        </svg>
        <span>Fluxo Visual (Kanban)</span>
      </button>

      <button class="tab-btn" data-view="alerts" id="tab-alerts">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <span>Alertas & Gargalos</span>
        <span class="tab-badge danger" id="badge-alertas-count" style="display: none;">3</span>
      </button>
    </nav>

    <!-- Top Action Buttons -->
    <div class="nav-actions">
      <button class="btn btn-secondary btn-sm" id="btn-reset-demo" title="Recarregar dados iniciais da demonstração">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Restaurar Demo</span>
      </button>

      <button class="btn btn-secondary btn-sm" id="btn-export-csv" title="Exportar dados filtrados para CSV">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Exportar CSV</span>
      </button>

      <button class="btn btn-primary" id="btn-new-riv">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Nova RIV</span>
      </button>
    </div>
  </div>
</header>
